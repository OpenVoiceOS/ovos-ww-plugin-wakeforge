{
 "family": "WakeHuBERT",
 "architecture": "mel-tcn",
 "input": {
  "name": "waveform",
  "shape": [
   "batch",
   "samples"
  ],
  "dtype": "float32",
  "sample_rate": 16000
 },
 "output": {
  "name": "features",
  "shape": [
   "batch",
   "frames",
   "128"
  ],
  "frame_rate_hz": 50.0,
  "hop_samples": 320
 },
 "feature_dim": 128,
 "streaming": true,
 "params": 641792,
 "student": {
  "channels": 256,
  "blocks": 8,
  "n_mels": 64,
  "mask_prob": 0.065,
  "steps": 30000
 },
 "teacher": {
  "model": "facebook/hubert-base-ls960",
  "layers": [
   4,
   8,
   12
  ]
 },
 "int8": {
  "file": "wakehubert_int8.onnx",
  "feature_cosine_mean": 0.9975,
  "feature_cosine_p01": 0.9901
 },
 "files": {
  "float32": "wakehubert.onnx",
  "int8": "wakehubert_int8.onnx"
 },
 "causal": true,
 "delay_ms": 100.0,
 "receptive_field_samples": 40000,
 "streaming_context_samples": 40000,
 "license": "apache-2.0"
}